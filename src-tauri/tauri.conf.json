{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Desktop Manager",
  "mainBinaryName": "cdm",
  "version": "0.1.13",
  "identifier": "vn.easygoing.claude-desktop-manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "removeUnusedCommands": true
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Preferences",
        "width": 760,
        "height": 560,
        "minWidth": 520,
        "minHeight": 360,
        "resizable": true,
        "center": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/namdseasygoingvn/claude-desktop-manager/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM4MkFGRkU0RTE5RTU3NDYKUldSR1Y1N2g1UDhxeUtMRnViREhJZE1Yd24xTnVUdUxxM203TFJjdU12TFFYbDJQRFl0TnRHbUgK"
    }
  }
}
